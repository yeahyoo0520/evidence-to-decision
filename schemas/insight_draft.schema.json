{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insight_draft.schema.json",
  "title": "AI-assisted preliminary insight draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "insight_id",
    "theme_id",
    "observation",
    "interpretation",
    "potential_opportunity",
    "evidence_ids",
    "confidence",
    "review_status",
    "draft_label"
  ],
  "properties": {
    "insight_id": {"type": "string", "minLength": 1},
    "theme_id": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "potential_opportunity": {
      "type": "string",
      "minLength": 1,
      "description": "Compatibility field currently used as an evidence review note, not an automatic business recommendation."
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {"enum": ["low", "medium", "high"]},
    "review_status": {"const": "preliminary"},
    "draft_label": {"const": "AI generated draft"}
  }
}
