{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision_brief.schema.json",
  "title": "Decision Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_brief_id", "source_effective_insight_ids", "source_theme_ids",
    "supporting_evidence_ids", "research_question", "decision_context", "analysis_mode",
    "why_it_matters", "decision_question", "possible_directions", "evidence_gaps",
    "validation_plan", "verification_statuses", "review_recommended", "review_reasons",
    "uncertainty_note", "status", "generated_at"
  ],
  "properties": {
    "decision_brief_id": {"type": "string", "minLength": 1},
    "source_effective_insight_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_theme_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supporting_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "research_question": {"type": ["string", "null"]},
    "decision_context": {"type": ["string", "null"]},
    "analysis_mode": {"enum": ["exploratory", "decision_focused"]},
    "why_it_matters": {"type": "string", "minLength": 1},
    "decision_question": {"type": "string", "minLength": 1},
    "possible_directions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/direction"}},
    "evidence_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation"}},
    "verification_statuses": {"type": "array", "uniqueItems": true, "items": {"enum": ["unreviewed", "reviewed", "edited"]}},
    "review_recommended": {"type": "boolean"},
    "review_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "uncertainty_note": {"type": "string", "minLength": 1},
    "status": {"const": "AI-generated decision support"},
    "generated_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "direction": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "rationale", "evidence_basis", "tradeoff_or_risk"],
      "properties": {
        "direction": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_basis": {"type": "string", "minLength": 1},
        "tradeoff_or_risk": {"type": "string", "minLength": 1}
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["gap", "why_it_matters", "related_insight_ids", "related_evidence_ids"],
      "properties": {
        "gap": {"type": "string", "minLength": 1},
        "why_it_matters": {"type": "string", "minLength": 1},
        "related_insight_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "related_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["validation_question", "method", "required_evidence", "evaluation_criterion", "limitation"],
      "properties": {
        "validation_question": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "required_evidence": {"type": "string", "minLength": 1},
        "evaluation_criterion": {"type": "string", "minLength": 1},
        "limitation": {"type": "string", "minLength": 1}
      }
    }
  }
}
