{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effective_insight.schema.json",
  "title": "Effective Insight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effective_insight_id",
    "source_insight_id",
    "source_theme_id",
    "theme_name",
    "theme_description",
    "final_observation",
    "final_interpretation",
    "evidence_ids",
    "representative_evidence_ids",
    "verification_status",
    "reviewer_note",
    "rejection_reason",
    "review_recommended",
    "review_reasons",
    "downstream_eligible",
    "confidence",
    "taxonomy_coverage",
    "coverage_reason",
    "research_context",
    "provenance"
  ],
  "properties": {
    "effective_insight_id": {"type": "string", "minLength": 1},
    "source_insight_id": {"type": "string", "minLength": 1},
    "source_theme_id": {"type": "string", "minLength": 1},
    "theme_name": {"type": "string", "minLength": 1},
    "theme_description": {"type": "string", "minLength": 1},
    "final_observation": {"type": "string", "minLength": 1},
    "final_interpretation": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "representative_evidence_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verification_status": {"enum": ["unreviewed", "reviewed", "edited", "rejected"]},
    "reviewer_note": {"type": "string"},
    "rejection_reason": {"type": "string"},
    "review_recommended": {"type": "boolean"},
    "review_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "downstream_eligible": {"type": "boolean"},
    "confidence": {"enum": ["low", "medium", "high"]},
    "taxonomy_coverage": {"enum": ["covered", "partially_covered", "emergent"]},
    "coverage_reason": {"type": "string", "minLength": 1},
    "research_context": {"$ref": "research_context.schema.json"},
    "provenance": {"enum": ["ai_generated", "human_edited"]}
  }
}
